# ==============================================================================
# Annapurna Rebuilt — Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL 14+)
DATABASE_URL="postgresql://user:password@localhost:5432/annapurna_db?schema=public"

# Session Security (Minimum 32 random characters for HMAC cookie signatures)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-secret-key-32chars"

# Optional AI Assistant Integration (Gemini API)
# When omitted, the platform deterministically falls back to rule-based analysis.
GEMINI_API_KEY=""

# Optional Notification Dispatch (SMTP or Webhook)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_FROM="alerts@annapurna.local"

# Node Environment
NODE_ENV="development"

# Lab Simulator Toggle (Set to "false" in production to reject simulation endpoints)
ENABLE_SIMULATOR="false"

# Scheduled Telemetry Gap Evaluation Bearer Secret (Used for authorized cron/scheduler invocations)
CRON_SECRET="replace-with-a-cryptographically-secure-random-secret-for-cron"

